{
  "language": "javascript",
  "format": "vscode-snippets-v1",
  "snippets": [
    {
      "prefix": "function",
      "body": [
        "function ${1:name}(${2:args}) {",
        "    ${3:/* body */}",
        "}"
      ],
      "description": "Function declaration."
    },
    {
      "prefix": "arrow",
      "body": [
        "const ${1:name} = (${2:args}) => ${3:expr};"
      ],
      "description": "Arrow function."
    },
    {
      "prefix": "async-arrow",
      "body": [
        "const ${1:name} = async (${2:args}) => {",
        "    ${3:await something();}",
        "};"
      ],
      "description": "Async arrow function."
    },
    {
      "prefix": "class",
      "body": [
        "class ${1:Name} {",
        "    constructor(${2:args}) {",
        "        ${3:/* */}",
        "    }",
        "}"
      ],
      "description": "Class declaration."
    },
    {
      "prefix": "extends",
      "body": [
        "class ${1:Child} extends ${2:Parent} {",
        "    constructor(${3:args}) {",
        "        super(${3:args});",
        "        ${4:/* */}",
        "    }",
        "}"
      ],
      "description": "Class extending another."
    },
    {
      "prefix": "if",
      "body": [
        "if (${1:condition}) {",
        "    ${2:/* */}",
        "}"
      ],
      "description": "If statement."
    },
    {
      "prefix": "if-else",
      "body": [
        "if (${1:condition}) {",
        "    ${2:/* */}",
        "} else {",
        "    ${3:/* */}",
        "}"
      ],
      "description": "If-else."
    },
    {
      "prefix": "ternary",
      "body": [
        "${1:cond} ? ${2:a} : ${3:b};"
      ],
      "description": "Ternary expression."
    },
    {
      "prefix": "for",
      "body": [
        "for (let ${1:i} = 0; i < ${2:n}; ${1:i}++) {",
        "    ${3:/* */}",
        "}"
      ],
      "description": "C-style for loop."
    },
    {
      "prefix": "for-of",
      "body": [
        "for (const ${1:item} of ${2:iterable}) {",
        "    ${3:/* */}",
        "}"
      ],
      "description": "For-of loop."
    },
    {
      "prefix": "for-in",
      "body": [
        "for (const ${1:key} in ${2:obj}) {",
        "    ${3:/* */}",
        "}"
      ],
      "description": "For-in loop."
    },
    {
      "prefix": "while",
      "body": [
        "while (${1:condition}) {",
        "    ${2:/* */}",
        "}"
      ],
      "description": "While loop."
    },
    {
      "prefix": "try",
      "body": [
        "try {",
        "    ${1:/* */}",
        "} catch (${2:e}) {",
        "    ${3:/* */}",
        "}"
      ],
      "description": "Try-catch."
    },
    {
      "prefix": "try-finally",
      "body": [
        "try {",
        "    ${1:/* */}",
        "} catch (${2:e}) {",
        "    ${3:/* */}",
        "} finally {",
        "    ${4:/* */}",
        "}"
      ],
      "description": "Try-catch-finally."
    },
    {
      "prefix": "console-log",
      "body": [
        "console.log(${1:\"text\"});"
      ],
      "description": "Console log."
    },
    {
      "prefix": "console-error",
      "body": [
        "console.error(${1:\"text\"});"
      ],
      "description": "Console error."
    },
    {
      "prefix": "promise",
      "body": [
        "new Promise((resolve, reject) => {",
        "    ${1:/* */}",
        "    resolve(${2:value});",
        "});"
      ],
      "description": "New Promise."
    },
    {
      "prefix": "async-function",
      "body": [
        "async function ${1:name}(${2:args}) {",
        "    ${3:await something();}",
        "}"
      ],
      "description": "Async function."
    },
    {
      "prefix": "await",
      "body": [
        "const ${1:result} = await ${2:promise};"
      ],
      "description": "Await a promise."
    },
    {
      "prefix": "export-default",
      "body": [
        "export default ${1:value};"
      ],
      "description": "Default export."
    },
    {
      "prefix": "export",
      "body": [
        "export const ${1:name} = ${2:value};"
      ],
      "description": "Named export."
    },
    {
      "prefix": "import",
      "body": [
        "import { ${1:name} } from \"${2:module}\";"
      ],
      "description": "Named import."
    },
    {
      "prefix": "import-default",
      "body": [
        "import ${1:name} from \"${2:module}\";"
      ],
      "description": "Default import."
    },
    {
      "prefix": "json-parse",
      "body": [
        "JSON.parse(${1:text});"
      ],
      "description": "JSON parse."
    },
    {
      "prefix": "json-stringify",
      "body": [
        "JSON.stringify(${1:obj}, null, 2);"
      ],
      "description": "JSON stringify pretty."
    }
  ]
}