{
  "language": "php",
  "format": "vscode-snippets-v1",
  "snippets": [
    {
      "prefix": "php-open",
      "body": [
        "<?php",
        "${1:/* body */}"
      ],
      "description": "PHP opening tag."
    },
    {
      "prefix": "php-echo",
      "body": [
        "echo ${1:\"text\"};"
      ],
      "description": "Echo statement."
    },
    {
      "prefix": "function",
      "body": [
        "function ${1:name}(${2:args}): ${3:void}",
        "{",
        "    ${4:/* body */}",
        "}"
      ],
      "description": "Function declaration."
    },
    {
      "prefix": "class",
      "body": [
        "class ${1:Name}",
        "{",
        "    public function __construct(${2:args})",
        "    {",
        "        ${3:/* */}",
        "    }",
        "}"
      ],
      "description": "Class declaration."
    },
    {
      "prefix": "interface",
      "body": [
        "interface ${1:Name}",
        "{",
        "    public function ${2:method}(): ${3:void};",
        "}"
      ],
      "description": "Interface declaration."
    },
    {
      "prefix": "trait",
      "body": [
        "trait ${1:Name}",
        "{",
        "    ${2:/* body */}",
        "}"
      ],
      "description": "Trait declaration."
    },
    {
      "prefix": "enum",
      "body": [
        "enum ${1:Name}: ${2:string}",
        "{",
        "    case ${3:Member} = ${4:\"value\"};",
        "}"
      ],
      "description": "Backed enum."
    },
    {
      "prefix": "if",
      "body": [
        "if (${1:condition}) {",
        "    ${2:/* */}",
        "}"
      ],
      "description": "If statement."
    },
    {
      "prefix": "if-else",
      "body": [
        "if (${1:condition}) {",
        "    ${2:/* */}",
        "} else {",
        "    ${3:/* */}",
        "}"
      ],
      "description": "If-else."
    },
    {
      "prefix": "for",
      "body": [
        "for ($${1:i} = 0; $${1:i} < ${2:n}; $${1:i}++) {",
        "    ${3:/* */}",
        "}"
      ],
      "description": "C-style for loop."
    },
    {
      "prefix": "foreach",
      "body": [
        "foreach ($${1:array} as $${2:value}) {",
        "    ${3:/* */}",
        "}"
      ],
      "description": "Foreach loop."
    },
    {
      "prefix": "while",
      "body": [
        "while (${1:condition}) {",
        "    ${2:/* */}",
        "}"
      ],
      "description": "While loop."
    },
    {
      "prefix": "try",
      "body": [
        "try {",
        "    ${1:/* */}",
        "} catch (${2:Exception} $e) {",
        "    ${3:/* */}",
        "}"
      ],
      "description": "Try-catch."
    },
    {
      "prefix": "arrow-fn",
      "body": [
        "fn(${1:args}) => ${2:expr};"
      ],
      "description": "Short closure (arrow function)."
    },
    {
      "prefix": "closure",
      "body": [
        "function (${1:args}) use ($${2:var}) {",
        "    ${3:/* */}",
        "};"
      ],
      "description": "Anonymous closure."
    },
    {
      "prefix": "property",
      "body": [
        "public ${1:Type} $${2:name};"
      ],
      "description": "Public class property."
    },
    {
      "prefix": "typed-property",
      "body": [
        "public ${1:Type} $${2:name};"
      ],
      "description": "Typed property."
    },
    {
      "prefix": "constructor-promotion",
      "body": [
        "public function __construct(",
        "    private ${1:Type} $${2:name}",
        ") {}"
      ],
      "description": "Constructor promotion."
    },
    {
      "prefix": "match",
      "body": [
        "match (${1:subject}) {",
        "    ${2:value1} => ${3:expr1},",
        "    ${4:value2} => ${5:expr2},",
        "    default => ${6:default},",
        "};"
      ],
      "description": "Match expression (8+)."
    }
  ]
}