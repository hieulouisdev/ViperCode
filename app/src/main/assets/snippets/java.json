{
  "language": "java",
  "format": "vscode-snippets-v1",
  "snippets": [
    {
      "prefix": "main",
      "body": [
        "public static void main(String[] args) {",
        "    System.out.println(\"Hello, World!\");",
        "}"
      ],
      "description": "Java main entry point."
    },
    {
      "prefix": "sout",
      "body": [
        "System.out.println(${1:\"text\"});"
      ],
      "description": "Print a line."
    },
    {
      "prefix": "soutv",
      "body": [
        "System.out.println(\"${1:var} = \" + ${1:var});"
      ],
      "description": "Print a variable."
    },
    {
      "prefix": "class",
      "body": [
        "public class ${1:Name} {",
        "    ${2:/* body */}",
        "}"
      ],
      "description": "Public class."
    },
    {
      "prefix": "interface",
      "body": [
        "public interface ${1:Name} {",
        "    ${2:/* methods */}",
        "}"
      ],
      "description": "Public interface."
    },
    {
      "prefix": "method",
      "body": [
        "public ${1:void} ${2:name}(${3:String args}) {",
        "    ${4:/* body */}",
        "}"
      ],
      "description": "Public method."
    },
    {
      "prefix": "if",
      "body": [
        "if (${1:condition}) {",
        "    ${2:/* then */}",
        "} else {",
        "    ${3:/* else */}",
        "}"
      ],
      "description": "If-else."
    },
    {
      "prefix": "for",
      "body": [
        "for (${1:int i = 0}; i < ${2:n}; i++) {",
        "    ${3:/* body */}",
        "}"
      ],
      "description": "C-style for loop."
    },
    {
      "prefix": "foreach",
      "body": [
        "for (${1:Type} ${2:item} : ${3:collection}) {",
        "    ${4:/* body */}",
        "}"
      ],
      "description": "For-each loop."
    },
    {
      "prefix": "while",
      "body": [
        "while (${1:condition}) {",
        "    ${2:/* body */}",
        "}"
      ],
      "description": "While loop."
    },
    {
      "prefix": "try",
      "body": [
        "try {",
        "    ${1:/* body */}",
        "} catch (${2:Exception} e) {",
        "    ${3:/* handle */}",
        "}"
      ],
      "description": "Try-catch."
    },
    {
      "prefix": "try-finally",
      "body": [
        "try {",
        "    ${1:/* body */}",
        "} catch (${2:Exception} e) {",
        "    ${3:/* handle */}",
        "} finally {",
        "    ${4:/* cleanup */}",
        "}"
      ],
      "description": "Try-catch-finally."
    },
    {
      "prefix": "string",
      "body": [
        "String ${1:name} = ${2:\"value\"};"
      ],
      "description": "String variable declaration."
    },
    {
      "prefix": "list",
      "body": [
        "List<${1:String}> ${2:list} = new ArrayList<>();"
      ],
      "description": "Declare an ArrayList."
    },
    {
      "prefix": "map",
      "body": [
        "Map<${1:String}, ${2:Integer}> ${3:map} = new HashMap<>();"
      ],
      "description": "Declare a HashMap."
    },
    {
      "prefix": "set",
      "body": [
        "Set<${1:String}> ${2:set} = new HashSet<>();"
      ],
      "description": "Declare a HashSet."
    },
    {
      "prefix": "lambda",
      "body": [
        "(${1:args}) -> ${2:body}"
      ],
      "description": "Lambda expression."
    },
    {
      "prefix": "stream",
      "body": [
        "${1:collection}.stream().forEach(${2:item} -> {",
        "    ${3:/* body */}",
        "});"
      ],
      "description": "Stream forEach."
    },
    {
      "prefix": "stream-map",
      "body": [
        "${1:collection}.stream().map(${2:item} -> ${3:item.transformed}).collect(Collectors.toList());"
      ],
      "description": "Stream map."
    },
    {
      "prefix": "stream-filter",
      "body": [
        "${1:collection}.stream().filter(${2:item} -> ${3:item.test()}).collect(Collectors.toList());"
      ],
      "description": "Stream filter."
    }
  ]
}